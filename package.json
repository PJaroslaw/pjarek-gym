{
  "name": "pjarek-gym-formatting",
  "private": true,
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.html\"",
    "format:all": "prettier --write \"**/*.{html,json,js,md,sql,yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.html\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.9",
    "prettier-plugin-sql": "0.20.0"
  },
  "lint-staged": {
    "**/*.{html,json,js,md,sql,yml,yaml}": "prettier --write"
  }
}
